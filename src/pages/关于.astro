---
import {getCollection,render} from 'astro:content';import BaseLayout from '../layouts/BaseLayout.astro';const page=(await getCollection('page')).find(p=>p.id.startsWith('about/'));if(!page)throw new Error('关于页面不存在');const {Content}=await render(page);
---
<BaseLayout title={page.data.title}><article class="panel article-content"><Content/></article></BaseLayout>
