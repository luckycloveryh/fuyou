---
import BaseLayout from '../layouts/BaseLayout.astro';import PostCard from '../components/PostCard.astro';import Pagination from '../components/Pagination.astro';import { getPosts } from '../utils/blog';
const posts=await getPosts();const size=3;
---
<BaseLayout><header class="page-header"><h1>最新文章</h1><p>记录运维、云原生与开发实践，共 {posts.length} 篇。</p></header><div class="post-list">{posts.slice(0,size).map(post=><PostCard post={post}/>)}</div><Pagination current={1} total={Math.ceil(posts.length/size)}/></BaseLayout>
