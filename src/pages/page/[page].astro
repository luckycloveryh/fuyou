---
import BaseLayout from '../../layouts/BaseLayout.astro';import PostCard from '../../components/PostCard.astro';import Pagination from '../../components/Pagination.astro';import { getPosts } from '../../utils/blog';
export async function getStaticPaths(){const posts=await getPosts();return Array.from({length:Math.ceil(posts.length/3)-1},(_,i)=>({params:{page:String(i+2)},props:{posts}}));}
const {posts}=Astro.props;const current=Number(Astro.params.page);
---
<BaseLayout title={`第 ${current} 页`}><header class="page-header"><h1>最新文章</h1></header><div class="post-list">{posts.slice((current-1)*3,current*3).map(post=><PostCard post={post}/>)}</div><Pagination current={current} total={Math.ceil(posts.length/3)}/></BaseLayout>
