---
import BaseLayout from '../../layouts/BaseLayout.astro';import {url} from '../../utils/blog';
---
<BaseLayout title="搜索"><header class="page-header"><h1>搜索</h1><p>输入一个或多个关键词，搜索标题与正文。</p></header><section class="panel"><label class="sr-only" for="search-input">搜索文章</label><input id="search-input" type="search" placeholder="例如：Kubernetes 监控" autocomplete="off" data-index={url('搜索/index.json')}/><div id="search-results"></div></section><script>
type Item={title:string;date:string;permalink:string;content:string};let items:Item[]=[];const input=document.querySelector('#search-input') as HTMLInputElement;const results=document.querySelector('#search-results') as HTMLDivElement;const indexUrl=input.dataset.index!;const escape=(s:string)=>s.replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]!));
let failed=false;async function load(){if(items.length)return;failed=false;results.innerHTML='<p role="status">正在加载搜索索引…</p>';try{const response=await fetch(indexUrl);if(!response.ok)throw new Error(String(response.status));items=await response.json();}catch{failed=true;results.innerHTML='<p role="alert">搜索索引加载失败，请检查网络后重试。</p>';}}
function search(){if(failed)return;const words=input.value.trim().toLowerCase().split(/\s+/).filter(Boolean);if(!words.length){results.innerHTML='<p>请输入关键词。</p>';return;}const found=items.map(item=>({item,score:words.reduce((n,w)=>n+(item.title.toLowerCase().includes(w)?5:0)+(item.content.toLowerCase().includes(w)?1:0),0)})).filter(x=>x.score>0).sort((a,b)=>b.score-a.score);results.innerHTML=found.length?found.map(({item})=>{const lower=item.content.toLowerCase();const pos=Math.max(0,lower.indexOf(words[0]));let excerpt=escape(item.content.slice(pos,pos+180));for(const w of words)excerpt=excerpt.replace(new RegExp(w.replace(/[.*+?^${}()|[\]\\]/g,'\\$&'),'gi'),m=>`<mark>${m}</mark>`);return `<article class="search-result"><a href="${item.permalink}"><h2>${escape(item.title)}</h2></a><time>${item.date.slice(0,10)}</time><p>${excerpt}…</p></article>`;}).join(''):'<p>没有找到相关内容。</p>';}
input.addEventListener('input',async()=>{await load();search();});const keyword=new URLSearchParams(location.search).get('keyword');if(keyword){input.value=keyword;load().then(search);}else results.innerHTML='<p>输入关键词开始搜索。</p>';
</script></BaseLayout>
