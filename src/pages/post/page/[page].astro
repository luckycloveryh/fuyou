---
import BaseLayout from '../../../layouts/BaseLayout.astro';import PostCard from '../../../components/PostCard.astro';import Pagination from '../../../components/Pagination.astro';import { getPosts } from '../../../utils/blog';
export async function getStaticPaths(){const posts=await getPosts();return Array.from({length:Math.ceil(posts.length/12)-1},(_,i)=>({params:{page:String(i+2)},props:{posts}}));}const {posts}=Astro.props;const current=Number(Astro.params.page);
---
<BaseLayout title={`全部文章 · 第 ${current} 页`}><div class="post-list">{posts.slice((current-1)*12,current*12).map(post=><PostCard post={post} compact/>)}</div><Pagination current={current} total={Math.ceil(posts.length/12)} section="post"/></BaseLayout>
