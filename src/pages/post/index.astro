---
import BaseLayout from '../../layouts/BaseLayout.astro';import PostCard from '../../components/PostCard.astro';import Pagination from '../../components/Pagination.astro';import { getPosts } from '../../utils/blog';const posts=await getPosts();
---
<BaseLayout title="全部文章"><header class="page-header"><h1>全部文章</h1><p>共 {posts.length} 篇</p></header><div class="post-list">{posts.slice(0,12).map(post=><PostCard post={post} compact/>)}</div><Pagination current={1} total={Math.ceil(posts.length/12)} section="post"/></BaseLayout>
