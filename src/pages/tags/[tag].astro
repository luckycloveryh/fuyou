---
import BaseLayout from '../../layouts/BaseLayout.astro';import PostCard from '../../components/PostCard.astro';import {getPosts,taxonomySlug} from '../../utils/blog';
export async function getStaticPaths(){const posts=await getPosts();return [...new Set(posts.flatMap(p=>p.data.tags))].map(name=>({params:{tag:taxonomySlug(name)},props:{name,posts:posts.filter(p=>p.data.tags.includes(name))}}));}const {name,posts}=Astro.props;
---
<BaseLayout title={`#${name}`}><header class="page-header"><h1>#{name}</h1><p>{posts.length} 篇文章</p></header><div class="post-list">{posts.map(post=><PostCard post={post}/>)}</div></BaseLayout>
