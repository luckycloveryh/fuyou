---
import BaseLayout from '../../layouts/BaseLayout.astro';import {getPosts,taxonomySlug,url} from '../../utils/blog';const posts=await getPosts();const names=[...new Set(posts.flatMap(p=>p.data.tags))].sort();
---
<BaseLayout title="标签"><header class="page-header"><h1>文章标签</h1></header><div class="taxonomy-grid">{names.map(name=><a class="taxonomy-card" href={url(`tags/${taxonomySlug(name)}`)}><strong>#{name}</strong><span>{posts.filter(p=>p.data.tags.includes(name)).length}</span></a>)}</div></BaseLayout>
