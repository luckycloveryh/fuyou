---
import { render } from 'astro:content';import BaseLayout from '../../layouts/BaseLayout.astro';import { getPosts,postSlug,postUrl,formatDate,url,taxonomySlug } from '../../utils/blog';
export async function getStaticPaths(){const posts=await getPosts();return posts.map((post,i)=>({params:{slug:postSlug(post)},props:{post,prev:posts[i-1],next:posts[i+1]}}));}
const {post,prev,next}=Astro.props;const {Content,headings}=await render(post);
---
<BaseLayout title={post.data.title} description={post.data.description} image={post.data.image}><div class="article-layout"><article class="article"><header class="article-header">{post.data.image&&<img class="article-cover" src={post.data.image} alt={post.data.title}/>}<div class="card-meta">{post.data.categories.map(c=><a href={url(`categories/${taxonomySlug(c)}`)}>{c}</a>)}</div><h1>{post.data.title}</h1><p>{post.data.description}</p><time>{formatDate(post.data.date)} · {(post.body || '').length} 字 · <span id="vercount_value_page_pv">--</span> 次阅读</time></header><div class="article-content"><Content/></div><footer class="article-footer"><div class="tags">{post.data.tags.map(t=><a href={url(`tags/${taxonomySlug(t)}`)}>#{t}</a>)}</div><p>本文采用 <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/deed.zh" target="_blank" rel="noreferrer">CC BY-NC-SA 4.0</a> 许可协议。</p>{post.data.lastmod&&<p>最后更新：{formatDate(post.data.lastmod)}</p>}<nav class="pagination">{prev?<a href={postUrl(prev)}>← {prev.data.title}</a>:<span/>}{next?<a href={postUrl(next)}>{next.data.title} →</a>:<span/>}</nav></footer><section id="comments"><h2>评论</h2><script is:inline>const comments=document.getElementById('comments');const script=document.createElement('script');script.src='https://utteranc.es/client.js';script.setAttribute('repo','luckycloveryh/fuyou');script.setAttribute('issue-term','pathname');script.setAttribute('theme','preferred-color-scheme');script.crossOrigin='anonymous';script.async=true;comments?.appendChild(script);</script></section></article><aside class="toc"><strong>本文目录</strong><ul>{headings.filter(h=>h.depth<=3).map(h=><li class={`depth-${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul></aside></div><script is:inline src="https://cn.vercount.one/js"></script></BaseLayout>
